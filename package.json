{
  "name": "prospect-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:migrate": "npm run migrate:deploy -w @prospect-ai/db",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "eslint": "10.16.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
