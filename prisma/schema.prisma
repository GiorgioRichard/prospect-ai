// Schema inicial proposto; Prisma 7: URL configurada em prisma.config.ts na implementação.
generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  members Membership[]
  leads Lead[]
}
model Membership {
  organizationId String @db.Uuid
  userId String @db.Uuid
  role String
  organization Organization @relation(fields: [organizationId], references: [id])
  @@id([organizationId, userId])
}
model Lead {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  stage String @default("NEW")
  version Int @default(0)
  createdAt DateTime @default(now())
  evidences Evidence[]
  sources LeadSource[]
  events LeadEvent[]
  @@unique([organizationId,id])
  @@index([organizationId,stage,createdAt])
}
model LeadSource {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId String @db.Uuid
  lead Lead @relation(fields:[organizationId,leadId],references:[organizationId,id])
  provider String
  externalId String
  observedAt DateTime @default(now())
  @@unique([organizationId,provider,externalId])
}
model Evidence {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId String @db.Uuid
  lead Lead @relation(fields:[organizationId,leadId],references:[organizationId,id])
  signalCode String
  sourceUrl String?
  observedValue Json
  status String
  methodologyVersion String
  observedAt DateTime
  expiresAt DateTime?
  verifiedBy String? @db.Uuid
  verifiedAt DateTime?
  @@index([organizationId,leadId,status])
}
model LeadEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId String @db.Uuid
  lead Lead @relation(fields:[organizationId,leadId],references:[organizationId,id])
  actorId String? @db.Uuid
  type String
  payload Json
  createdAt DateTime @default(now())
  @@index([organizationId,leadId,createdAt])
}
model Suppression {
  organizationId String @db.Uuid
  channel String
  contactHash String
  createdAt DateTime @default(now())
  @@id([organizationId,channel,contactHash])
}
