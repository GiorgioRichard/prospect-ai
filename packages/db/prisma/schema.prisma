// Prisma 7: URL configurada em prisma.config.ts. RLS e funções do schema `app` estão nas migrações (ADR-006).
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  members   Membership[]
  leads     Lead[]
}

model Membership {
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Lead {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  stage          String       @default("NEW")
  version        Int          @default(0)
  createdAt      DateTime     @default(now())
  evidences      Evidence[]
  sources        LeadSource[]
  events         LeadEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, stage, createdAt])
}

model LeadSource {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  lead           Lead     @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  provider       String
  externalId     String
  observedAt     DateTime @default(now())

  @@unique([organizationId, provider, externalId])
}

model Evidence {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  leadId             String    @db.Uuid
  lead               Lead      @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  signalCode         String
  sourceUrl          String?
  observedValue      Json
  status             String
  methodologyVersion String
  observedAt         DateTime
  expiresAt          DateTime?
  verifiedBy         String?   @db.Uuid
  verifiedAt         DateTime?

  @@index([organizationId, leadId, status])
}

model LeadEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  lead           Lead     @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Cascade)
  actorId        String?  @db.Uuid
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([organizationId, leadId, createdAt])
}

model Suppression {
  organizationId String   @db.Uuid
  channel        String
  contactHash    String
  createdAt      DateTime @default(now())

  @@id([organizationId, channel, contactHash])
}
