# Copie para .env e ajuste localmente. Nunca versione valores reais.
PORT=4000

# Migrações: role prospect_owner (dono do schema). Nunca usar em runtime.
DATABASE_URL=postgresql://prospect_owner:CHANGE_ME@localhost:5432/prospect_ai_dev
# Runtime da API/worker: role app_user, sujeita a RLS (ADR-006).
APP_DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/prospect_ai_dev

# Testes de integração (banco descartável; o nome deve terminar em _test).
TEST_DATABASE_URL=postgresql://prospect_owner:CHANGE_ME@localhost:5432/prospect_ai_test
TEST_APP_DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/prospect_ai_test

# Supabase Auth (valores públicos do projeto; não são segredos).
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
